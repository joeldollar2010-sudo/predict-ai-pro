/* =========================
   PRONOSTIC API-FOOTBALL
========================= */

app.get(
    "/api/predictions/:fixtureId",
    async (req, res) => {

        try {

            const fixtureId =
                req.params.fixtureId;

            if (!/^\d+$/.test(fixtureId)) {

                return res.status(400).json({
                    success: false,
                    error: "ID du match invalide."
                });
            }

            const data =
                await footballRequest(
                    "/predictions",
                    {
                        fixture: fixtureId
                    }
                );

            res.json({
                success: true,
                prediction:
                    data.response?.[0] || null
            });

        } catch (error) {

            console.error(
                "Erreur /api/predictions :",
                error.message
            );

            res.status(500).json({
                success: false,
                error: error.message
            });
        }
    }
);

